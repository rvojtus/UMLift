<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>cz.cuni.mff.umlift.plugin.intellij</id>

    <!-- Public plugin name should be written in Title Case.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/plugin-overview-page.html#plugin-name -->
    <name>UMLift</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor email="rastislav.vojtus@gmail.com">Rastislav Vojtuš</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Simple HTML elements (text formatting, paragraphs, and lists) can be added inside of <![CDATA[ ]]> tag.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/plugin-overview-page.html#plugin-description -->
    <description>
        <![CDATA[
    Adds support for Informal Model-Driven Development by integrating UMLet 15.1
    with the Eclipse Modeling Framework (EMF) to generate various artifacts and code.
    This plugin builds upon the UMLet project but is independently developed.
    <br>
    Features:
    <ul>
      <li>Integrated UMLet GUI – Edit and visualize <code>.uxf</code> files directly within the file editor.</li>
      <li>Seamless UXF to EMF Transformation – Convert UMLet diagrams into Ecore and GenModel files.</li>
      <li>Code & Artifact Generation – Automatically generate Java code and other artifacts from EMF models.</li>
    </ul>
    Note: UMLet is an independent open-source project. Learn more at the
    <a href="https://www.umlet.com/">official UMLet site</a>.
    ]]>
    </description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>

    <!-- Extension points defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <fileEditorProvider
                implementation="cz.cuni.mff.umlift.plugin.intellij.editor.UMLetFileEditorProvider"/>
        <applicationService
                serviceImplementation="cz.cuni.mff.umlift.plugin.intellij.settings.EMFSettings"/>
        <applicationConfigurable
                parentId="tools"
                instance="cz.cuni.mff.umlift.plugin.intellij.settings.EMFSettingsConfigurable"
                id="cz.cuni.mff.umlift.plugin.intellij.settings.EMFSettingsConfigurable"
                displayName="UMLift"/>
        <notificationGroup displayType="BALLOON" id="cz.cuni.mff.umlift.plugin.intellij.notificationgroup"/>
        <fileType name="Ecore File"
                  implementationClass="cz.cuni.mff.umlift.plugin.intellij.filetypes.EcoreFileType"
                  fieldName="INSTANCE"
                  language="XML"
                  extensions="ecore"/>
        <fileType name="GenModel File"
                  implementationClass="cz.cuni.mff.umlift.plugin.intellij.filetypes.GenModelFileType"
                  fieldName="INSTANCE"
                  language="XML"
                  extensions="genmodel"/>
    </extensions>

    <applicationListeners>
        <listener class="cz.cuni.mff.umlift.plugin.intellij.customsaving.SaveRequestListener"
                  topic="com.intellij.openapi.actionSystem.ex.AnActionListener"/>
    </applicationListeners>

    <actions>
        <group id="cz.cuni.mff.umlift.plugin.intellij.actions.MainGroup"
               class="cz.cuni.mff.umlift.plugin.intellij.contextmenu.UMLiftActionGroup"
               popup="true" text="UMLift"
               description="Contains actions for processing UMLet and Eclipse Modeling Framework files">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
            <add-to-group group-id="EditorTabPopupMenu" anchor="last"/>
            <action id="UxfFileContextMenuAction"
                    class="cz.cuni.mff.umlift.plugin.intellij.contextmenu.UMLetToEMFContextMenuAction"
                    text="Transform UMLet to EMF" description="Transforms UMLet File to EMF Ecore and GenModel files">
            </action>
            <action id="UxfFile2CodeContextMenuAction"
                    class="cz.cuni.mff.umlift.plugin.intellij.contextmenu.UMLet2CodeContextMenuAction"
                    text="Generate Code from UMLet" description="Generates Code and Artifacts from UMLet diagram file">
            </action>
            <action id="GenerateCodeContextMenuAction"
                    class="cz.cuni.mff.umlift.plugin.intellij.contextmenu.GenerateCodeContextMenuAction"
                    text="Generate Code from Ecore"
                    description="Generates Code and Artifacts from EMF Ecore and GenModel files">
            </action>
        </group>
    </actions>

</idea-plugin>