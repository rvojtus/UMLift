<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="exampleProject" nsURI="https://example.org/exampleProject" nsPrefix="exampleProjectPrefix">
  <eClassifiers xsi:type="ecore:EClass" name="Hospital">
    <eStructuralFeatures xsi:type="ecore:EReference" name="Department" lowerBound="1" upperBound="-1" eType="//Department"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="Building" lowerBound="1" upperBound="-1" eType="//Building" eOpposite="//Building/Hospital"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="AdminDepartment" lowerBound="1" upperBound="-1" eType="//AdminDepartment"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Department">
    <eStructuralFeatures xsi:type="ecore:EReference" name="Staff" lowerBound="1" upperBound="-1" eType="//Staff"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Building">
    <eStructuralFeatures xsi:type="ecore:EReference" name="Floor" lowerBound="1" upperBound="-1" eType="//Floor"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="Hospital" lowerBound="1" eType="//Hospital" eOpposite="//Hospital/Building"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Floor">
    <eStructuralFeatures xsi:type="ecore:EReference" name="PatientRoom" upperBound="-1" eType="//PatientRoom" eOpposite="//PatientRoom/Floor"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Staff" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EReference" name="TimeSlot" eType="//TimeSlot" eOpposite="//TimeSlot/Staff"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Nurse" eSuperTypes="//Staff">
    <eStructuralFeatures xsi:type="ecore:EReference" name="Patient" upperBound="-1" eType="//Patient" eOpposite="//Patient/Nurse"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Receptionist" eSuperTypes="//Staff"/>
  <eClassifiers xsi:type="ecore:EClass" name="Technician" eSuperTypes="//Staff"/>
  <eClassifiers xsi:type="ecore:EClass" name="Janitor" eSuperTypes="//Staff"/>
  <eClassifiers xsi:type="ecore:EClass" name="Security" eSuperTypes="//Staff"/>
  <eClassifiers xsi:type="ecore:EClass" name="IT" eSuperTypes="//Staff"/>
  <eClassifiers xsi:type="ecore:EClass" name="Patient">
    <eStructuralFeatures xsi:type="ecore:EReference" name="Doctor" upperBound="-1" eType="//Doctor" eOpposite="//Doctor/Patient"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="Nurse" upperBound="-1" eType="//Nurse" eOpposite="//Nurse/Patient"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="EmergencyContact" lowerBound="1" upperBound="-1" eType="//EmergencyContact" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="MedicalRecord" lowerBound="1" upperBound="-1" eType="//MedicalRecord" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="Prescription" upperBound="-1" eType="//Prescription"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="Appointment" eType="//Appointment"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="Billing" eType="//Billing" eOpposite="//Billing/Patient"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="Insurance" eType="//Insurance" eOpposite="//Insurance/Patient"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="PatientRoom" eType="//PatientRoom" eOpposite="//PatientRoom/Patient"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="EmergencyContact"/>
  <eClassifiers xsi:type="ecore:EClass" name="MedicalRecord">
    <eStructuralFeatures xsi:type="ecore:EReference" name="LabReport" upperBound="-1" eType="//LabReport"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="Doctor" lowerBound="1" eType="//Doctor"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="Diagnosis" upperBound="-1" eType="//Diagnosis"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="Allergy" eType="//Allergy"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="Treatment" upperBound="-1" eType="//Treatment"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Prescription">
    <eStructuralFeatures xsi:type="ecore:EReference" name="Medication" lowerBound="1" upperBound="-1" eType="//Medication"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="LabReport"/>
  <eClassifiers xsi:type="ecore:EClass" name="Diagnosis"/>
  <eClassifiers xsi:type="ecore:EClass" name="Treatment"/>
  <eClassifiers xsi:type="ecore:EClass" name="Appointment"/>
  <eClassifiers xsi:type="ecore:EClass" name="Schedule">
    <eStructuralFeatures xsi:type="ecore:EReference" name="TimeSlot" lowerBound="1" upperBound="-1" eType="//TimeSlot"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="TimeSlot">
    <eStructuralFeatures xsi:type="ecore:EReference" name="Staff" upperBound="-1" eType="//Staff" eOpposite="//Staff/TimeSlot"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Billing">
    <eStructuralFeatures xsi:type="ecore:EReference" name="Payment" lowerBound="1" upperBound="-1" eType="//Payment"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="Patient" lowerBound="1" eType="//Patient" eOpposite="//Patient/Billing"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Insurance">
    <eStructuralFeatures xsi:type="ecore:EReference" name="Patient" upperBound="-1" eType="//Patient" eOpposite="//Patient/Insurance"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Payment"/>
  <eClassifiers xsi:type="ecore:EClass" name="PatientRoom">
    <eStructuralFeatures xsi:type="ecore:EReference" name="Equipment" upperBound="-1" eType="//Equipment"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="Patient" upperBound="-1" eType="//Patient" eOpposite="//Patient/PatientRoom"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="Floor" lowerBound="1" eType="//Floor" eOpposite="//Floor/PatientRoom"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Equipment"/>
  <eClassifiers xsi:type="ecore:EClass" name="Inventory">
    <eStructuralFeatures xsi:type="ecore:EReference" name="Medication" upperBound="-1" eType="//Medication"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="Equipment" lowerBound="1" upperBound="-1" eType="//Equipment"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="Supplies" lowerBound="1" eType="//Supplies" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="Allergy"/>
  <eClassifiers xsi:type="ecore:EClass" name="Medication"/>
  <eClassifiers xsi:type="ecore:EClass" name="Supplies"/>
  <eClassifiers xsi:type="ecore:EClass" name="Doctor">
    <eStructuralFeatures xsi:type="ecore:EReference" name="Patient" upperBound="-1" eType="//Patient" eOpposite="//Patient/Doctor"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="TreatmentRoom" lowerBound="1" eType="//TreatmentRoom" eOpposite="//TreatmentRoom/Doctor"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Surgeon" eSuperTypes="//Doctor"/>
  <eClassifiers xsi:type="ecore:EClass" name="Anesthesiologist" eSuperTypes="//Doctor"/>
  <eClassifiers xsi:type="ecore:EClass" name="Radiologist" eSuperTypes="//Doctor"/>
  <eClassifiers xsi:type="ecore:EClass" name="Pharmacist" eSuperTypes="//Staff"/>
  <eClassifiers xsi:type="ecore:EClass" name="OperatingRoom" eSuperTypes="//TreatmentRoom"/>
  <eClassifiers xsi:type="ecore:EClass" name="ICU" eSuperTypes="//TreatmentRoom"/>
  <eClassifiers xsi:type="ecore:EClass" name="GeneralRoom" eSuperTypes="//TreatmentRoom"/>
  <eClassifiers xsi:type="ecore:EClass" name="Laboratory" eSuperTypes="//TreatmentRoom"/>
  <eClassifiers xsi:type="ecore:EClass" name="HR" eSuperTypes="//AdminDepartment"/>
  <eClassifiers xsi:type="ecore:EClass" name="Finance" eSuperTypes="//AdminDepartment"/>
  <eClassifiers xsi:type="ecore:EClass" name="Legal" eSuperTypes="//AdminDepartment"/>
  <eClassifiers xsi:type="ecore:EClass" name="Records" eSuperTypes="//AdminDepartment"/>
  <eClassifiers xsi:type="ecore:EClass" name="AdminDepartment" abstract="true" interface="true"/>
  <eClassifiers xsi:type="ecore:EClass" name="TreatmentRoom" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EReference" name="Doctor" upperBound="-1" eType="//Doctor" eOpposite="//Doctor/TreatmentRoom"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Radiology" eSuperTypes="//TreatmentRoom"/>
</ecore:EPackage>
